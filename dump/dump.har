          "content": {
            "size": 21150,
            "mimeType": "text/html",
            "text": "<!doctype html><html lang=\"en\"><head>\n<script type=\"importmap\">{\"imports\":{\"moomoo-protocol\":\"/p/s16prw.js\",\"moomoo-seal\":\"/p/40755ae27bb9e3e46f0125b8d8119418.js\"}}</script><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,minimum-scale=1,user-scalable=0,viewport-fit=cover\"><title>MooMoo.io - Free Multiplayer Survival IO Game</title><meta name=\"description\" content=\"Play MooMoo.io, a free multiplayer survival .io game. Gather resources, build your village, craft weapons and defend your windmills against players from around the world.\"><meta name=\"keywords\" content=\"moomoo, moomoo.io, io game, survival game, multiplayer, online game, village, farm, build, browser game, free game\"><meta name=\"robots\" content=\"index, follow\"><meta name=\"theme-color\" content=\"#3367D6\"><link rel=\"canonical\" href=\"https://moomoo.io/\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"MooMoo.io\"><meta property=\"og:title\" content=\"MooMoo.io - Free Multiplayer Survival IO Game\"><meta property=\"og:description\" content=\"Gather resources, build your village, craft weapons and defend your windmills against players from around the world. Play MooMoo.io free in your browser.\"><meta property=\"og:url\" content=\"https://moomoo.io/\"><meta property=\"og:image\" content=\"https://moomoo.io/img/og-image.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta property=\"og:image:alt\" content=\"MooMoo.io - Gather. Build. Survive.\"><meta property=\"og:image:type\" content=\"image/jpeg\"><meta property=\"og:locale\" content=\"en_US\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"MooMoo.io - Free Multiplayer Survival IO Game\"><meta name=\"twitter:description\" content=\"Gather resources, build your village, craft weapons and defend your windmills against players from around the world. Play MooMoo.io free in your browser.\"><meta name=\"twitter:image\" content=\"https://moomoo.io/img/og-image.jpg\"><meta name=\"twitter:image:alt\" content=\"MooMoo.io - Gather. Build. Survive.\"><link rel=\"manifest\" href=\"./manifest.json\"><link rel=\"shortcut icon\" type=\"image/png\" href=\"./img/favicon.png?v=2\"/><link rel=\"apple-touch-icon\" href=\"./img/pwa-icon192x192.png\"><meta name=\"mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-title\" content=\"MooMoo.io\"><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\"><meta name=\"application-name\" content=\"MooMoo.io\"><meta name=\"format-detection\" content=\"telephone=no\"><meta http-equiv=\"cache-control\" content=\"no-cache\"><meta http-equiv=\"expires\" content=\"0\"><meta http-equiv=\"pragma\" content=\"no-cache\"><script type=\"application/ld+json\">{\n\t\t\"@context\": \"https://schema.org\",\n\t\t\"@type\": \"VideoGame\",\n\t\t\"name\": \"MooMoo.io\",\n\t\t\"url\": \"https://moomoo.io/\",\n\t\t\"description\": \"MooMoo.io is a free multiplayer survival .io game. Gather resources, build your village, craft weapons and defend your windmills against players from around the world.\",\n\t\t\"image\": \"https://moomoo.io/img/pwa-icon512x512.png\",\n\t\t\"genre\": [\"Survival\", \"IO\", \"Multiplayer\"],\n\t\t\"gamePlatform\": \"Web Browser\",\n\t\t\"applicationCategory\": \"Game\",\n\t\t\"operatingSystem\": \"Any\",\n\t\t\"playMode\": \"MultiPlayer\",\n\t\t\"inLanguage\": \"en\",\n\t\t\"author\": { \"@type\": \"Organization\", \"name\": \"FRVR\", \"url\": \"https://frvr.com/\" },\n\t\t\"publisher\": { \"@type\": \"Organization\", \"name\": \"FRVR\", \"url\": \"https://frvr.com/\" },\n\t\t\"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\", \"availability\": \"https://schema.org/InStock\" }\n\t}</script><link rel=\"preconnect\" href=\"https://api.moomoo.io\" crossorigin><link rel=\"preconnect\" href=\"https://challenges.cloudflare.com\"><link rel=\"preload\" href=\"./css/fonts/qWcyB624q4L_C4jGQ9IK0O_dFlnrtREl.woff2\" as=\"font\" type=\"font/woff2\" crossorigin><link rel=\"stylesheet\" href=\"css/main.css?52\"/><link href=\"./css/material-icons.css?4\" rel=\"stylesheet\"><link href=\"./css/hammersmith-one.css?3\" rel=\"stylesheet\"><script type=\"module\" crossorigin src=\"./assets/index-993d072d.js\"></script><link rel=\"modulepreload\" crossorigin href=\"./assets/vendor-a3a301f0.js\"></head><body><script src=\"./libs/frvr-sdk.min.js?4\"></script><script src=\"./libs/frvr-channel-web.min.js?4\"></script><script>window.FRVR.config = {\"gameId\":\"moomoo\",\"consent\":{\"providerName\":\"cookiepro\",\"config\":{\"websiteKey\":\"XXX\"}},\"tracker\":{\"trackerChannelId\":\"moomoo_io\"},\"ads\":{\"providers\":[{\"name\":\"adsbygoogle-interstitial\",\"type\":\"interstitial\",\"config\":{\"timeout\":500}},{\"name\":\"adsbygoogle-reward\",\"type\":\"reward\",\"config\":{\"timeout\":500}}],\"throttling\":{\"maxfrequency\":0}}};\n\t\ttry {\n\t\t\t\tconst isMoomooIo = document.location.hostname.endsWith('moomoo.io');\n\t\t\t\tconst isKrunkerIo = document.location.hostname.endsWith('krunker.io');\n\t\t\t\tconst cookieproKey = isMoomooIo ? \"c94e102c-455a-4bf1-82b7-8c7f938301b6\" : \"15b4472b-823a-468e-b5eb-6eeaca5d6de4\";\n\t\t\t\tif (location.hostname !== 'localhost' && window.FRVR.config.consent) {\n\t\t\t\t\twindow.FRVR.config.consent.config.websiteKey = cookieproKey;\n\t\t\t\t} else {\n\t\t\t\t\tdelete window.FRVR.config.consent;\n\t\t\t\t}\n\n\t\t\t\twindow.FRVR.init('prod');\n\t\t\t\twindow.FRVR.tracker.addExtraFieldFunction(function(fields) {\n\t\t\t\t\t\tfields.context = 'moomoo';\n\t\t\t\t\t\tfields.app_version = '1.9.4';\n\t\t\t\t\t\tif (isKrunkerIo) {\n\t\t\t\t\t\t\tfields.channel = 'krunker_io';\n\t\t\t\t\t\t} else if (isMoomooIo) {\n\t\t\t\t\t\t\tfields.channel = 'moomoo_io';\n\t\t\t\t\t\t}\n\t\t\t\t});\n\t\t} catch(e) {\n\t\t\t\tconsole.error('[FRVR] sdk failed init');\n\t\t}</script><script defer=\"defer\" src=\"./libs/howler.core.min.js?2\"></script><div id=\"pre-content-container\" style=\"display:none\"></div><div id=\"errorNotification\" class=\"menuCard\" style=\"display:none\"><div>It looks like MooMoo ran in to a problem. Please try <a target=\"_blank\" href=\"https://www.computerhope.com/issues/ch001411.htm\">disabling all of your browser extensions</a> and reloading the page.</div><div style=\"text-align:center\"><a onclick=\"errorNotification.style.display = 'none'\" style=\"cursor:pointer\">Hide</a></div></div><div id=\"shutdownDisplay\" hidden></div><div id=\"pageNotices\"><div id=\"noticeDisplay\" hidden></div><div id=\"updateNotice\" hidden>Update available - <a href=\"javascript:void(window.location.reload())\">reload</a></div></div><div id=\"mainMenu\"><div id=\"menuContainer\"><div id=\"gameName\" aria-label=\"MOOMOO.io\"><span style=\"--i:0\">M</span><span style=\"--i:1\">O</span><span style=\"--i:2\">O</span><span style=\"--i:3\">M</span><span style=\"--i:4\">O</span><span style=\"--i:5\">O</span><span style=\"--i:6\">.</span><span style=\"--i:7\">i</span><span style=\"--i:8\">o</span></div><div id=\"loadingText\">Loading...</div><div id=\"menuCardHolder\" style=\"display:none\"><div class=\"menuCard\" id=\"menuDialog\"><div class=\"menuView\" data-view=\"play\"><div id=\"identityRow\"><div id=\"skinButton\" title=\"Choose your color\"></div><input id=\"nameInput\" placeholder=\"Enter Name\" maxlength=\"15\"><div id=\"skinPopover\" style=\"display:none\"><div id=\"skinColorHolder\"></div></div></div><div id=\"nameHint\"></div><div id=\"menuNotice\"></div><div id=\"playButtons\"><div id=\"enterGame\" class=\"menuButton\"><span>Play as Guest</span></div><div id=\"signInButton\" class=\"menuButton secondary\"><span>Sign In</span></div></div><div id=\"signInHint\">Sign in to keep your name and stats</div><div id=