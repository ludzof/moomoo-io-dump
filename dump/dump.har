            "text": "<!doctype html><html lang=\"en\"><head>\n<script type=\"importmap\">{\"imports\":{\"moomoo-protocol\":\"/p/s16prw.js\",\"moomoo-seal\":\"/p/40755ae27bb9e3e46f0125b8d8119418.js\"}}</script><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,minimum-scale=1,user-scalable=0,viewport-fit=cover\"><title>MooMoo.io - Free Multiplayer Survival IO Game</title><meta name=\"description\" content=\"Play MooMoo.io, a free multiplayer survival .io game. Gather resources, build your village, craft weapons and defend your windmills against players from around the world.\"><meta name=\"keywords\" content=\"moomoo, moomoo.io, io game, survival game, multiplayer, online game, village, farm, build, browser game, free game\"><meta name=\"robots\" content=\"index, follow\"><meta name=\"theme-color\" content=\"#3367D6\"><link rel=\"canonical\" href=\"https://moomoo.io/\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"MooMoo.io\"><meta property=\"og:title\" content=\"MooMoo.io - Free Multiplayer Survival IO Game\"><meta property=\"og:description\" content=\"Gather resources, build your village, craft weapons and defend your windmills against players from around the world. Play MooMoo.io free in your browser.\"><meta property=\"og:url\" content=\"https://moomoo.io/\"><meta property=\"og:image\" content=\"https://moomoo.io/img/og-image.jpg\"><meta property=\"og:image:width\" content=\"1200\"><meta property=\"og:image:height\" content=\"630\"><meta property=\"og:image:alt\" content=\"MooMoo.io - Gather. Build. Survive.\"><meta property=\"og:image:type\" content=\"image/jpeg\"><meta property=\"og:locale\" content=\"en_US\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"MooMoo.io - Free Multiplayer Survival IO Game\"><meta name=\"twitter:description\" content=\"Gather resources, build your village, craft weapons and defend yo