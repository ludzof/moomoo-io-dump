le=\"false\">Discord</a> | <a href=\"https://frvr.com/legal#TermsofService\" target=\"_blank\" class=\"menuLink\" draggable=\"false\">Terms</a> | <a href=\"https://frvr.com/legal#PrivacyPolicy\" target=\"_blank\" class=\"menuLink\" draggable=\"false\">Privacy</a> | <a href=\"https://frvr.com/\" target=\"_blank\" rel=\"noopener\" class=\"menuLink\" draggable=\"false\">FRVR</a></div></div><div id=\"netStats\"><span id=\"pingDisplay\" hidden><span class=\"signalBars\"><i></i><i></i><i></i><i></i></span><span id=\"pingText\">-- ms</span></span> <span id=\"fpsDisplay\" hidden>-- FPS</span> <span id=\"cpsDisplay\" hidden>0 CPS</span></div><div id=\"diedText\">YOU DIED</div><div id=\"touch-controls-left\"></div><div id=\"touch-controls-right\"></div><div id=\"touch-controls-fullscreen\"></div><div id=\"settingsPopup\" class=\"menuCard\" style=\"display:none\"><div class=\"viewHeader\"><span id=\"settingsPopupTitle\"></span><a id=\"settingsPopupClose\" class=\"viewBack\"><i class=\"material-icons\">&#xE5CD;</i></a></div><div class=\"viewBody\"><div class=\"popupPart\" data-part=\"social\" style=\"display:none\"><div id=\"socialSignedOut\" class=\"menuText\"></div><div id=\"accountPrefs\" style=\"display:none\"><div class=\"settingRadio\"><input id=\"prefFriendNotifs\" type=\"checkbox\"/> Friend Notifications</div><div class=\"settingRadio\"><input id=\"prefFriendRequests\" type=\"checkbox\"/> Allow Friend Requests</div><div class=\"settingRadio\"><input id=\"prefClanInvites\" type=\"checkbox\"/> Allow Clan Invitations</div><div class=\"settingRadio\" title=\"Reply from the game's chat with /w name message, or /r message\"><input id=\"prefToastWhispers\" type=\"checkbox\"/> Show Friend Messages In Game</div><div class=\"settingRadio\" title=\"Reply from the game's chat with /c message\"><input id=\"prefToastClan\" type=\"checkbox\"/> Show Clan Messages In Game</div><div class=\"settingRadio\" title=\"Other players see Anon#number for your name, and no clan. You still see your own.\"><input id=\"prefAnon\" type=\"checkbox\"/> Anonymous Mode</div><div class=\"settingRadio\" id=\"prefAnonSelfRow\" style=\"margin-left:26px\"><input id=\"prefAnonSelf\" type=\"checkbox\"/> Show my own name to me</div><div id=\"prefAnonNote\" class=\"keybindNote\" style=\"display:none\"></div></div><a id=\"settingsProfileLink\" class=\"menuLink\">My profile</a> <a id=\"settingsLookLink\" class=\"menuLink\">Edit look</a></div><div class=\"popupPart\" data-part=\"look\" style=\"display:none\"><div id=\"lookEditor\"></div></div><div class=\"popupPart\" data-part=\"shop\" id=\"shopSection\" style=\"display:none\"><div class=\"menuText\">Drag items into the order you want them in the shop. The eye hides one.</div><div class=\"settingRadio\"><input id=\"shopCombined\" type=\"checkbox\"/> Combined Shop</div><div id=\"shopEditor\"></div></div><div class=\"popupPart\" data-part=\"keys\" id=\"keybindSection\" style=\"display:none\"><div class=\"menuText\">Click a key to change it. Items can be bound by where they sit in your bar, by what they are, or both. Items you only ever have one of (pit trap or boost pad, say) share a row and a key.</div><div id=\"keybindHolder\"></div></div></div></div><div id=\"profileCard\" class=\"menuCard\" style=\"display:none\"><div class=\"menuHeader\" id=\"profileName\"></div><div id=\"profileRole\"></div><a id=\"profileClan\"></a><div id=\"profileNote\"></div><div id=\"profileLive\"></div><div id=\"profileStats\"></div><div id=\"profilePeriods\"></div><div id=\"profileSocials\"></div><div id=\"profileActions\"></div><div id=\"profileStatus\"></div><div id=\"profileClose\" class=\"cardClose\" title=\"Close\"><i class=\"material-icons\">&#xE5CD;</i></div></div><div id=\"textureCard\" class=\"menuCard\" style=\"display:none\"><div class=\"menuHeader\"></div><div id=\"textureBar\"></div><div id=\"textureStatus\"></div><div id=\"textureBody\"></div><div id=\"textureClose\" class=\"cardClose\" title=\"Close\"><i class=\"material-icons\">&#xE5