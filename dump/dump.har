le=\"false\">Discord</a> | <a href=\"https://frvr.com/legal#TermsofService\" target=\"_blank\" class=\"menuLink\" draggable=\"false\">Terms</a> | <a href=\"https://frvr.com/legal#PrivacyPolicy\" target=\"_blank\" class=\"menuLink\" draggable=\"false\">Privacy</a> | <a href=\"https://frvr.com/\" target=\"_blank\" rel=\"noopener\" class=\"menuLink\" draggable=\"false\">FRVR</a></div></div><div id=\"netStats\"><span id=\"pingDisplay\" hidden><span class=\"signalBars\"><i></i><i></i><i></i><i></i></span><span id=\"pingText\">-- ms</span></span> <span id=\"fpsDisplay\" hidden>-- FPS</span> <span id=\"cpsDisplay\" hidden>0 CPS</span></div><div id=\"diedText\">YOU DIED</div><div id=\"touch-controls-left\"></div><div id=\"touch-controls-right\"></div><div id=\"touch-controls-fullscreen\"></div><div id=\"settingsPopup\" class=\"menuCard\" style=\"display:none\"><div class=\"viewHeader\"><span id=\"settingsPopupTitle\"></span><a id=\"settingsPopupClose\" class=\"viewBack\"><i class=\"material-icons\">&#xE5CD;</i></a></div><div class=\"viewBody\"><div class=\"popupPart\" data-part=\"social\" style=\"display:none\"><div id=\"socialSignedOut\" class=\"menuText\"></div><div id=\"accountPrefs\" style=\"display:none\"><div class=\"settingRadio\"><input id=\"prefFriendNotifs\" type=\"checkbox\"/> Friend Notifications</div><div class=\"settingRadio\"><input id=\"prefFriendRequests\" type=\"checkbox\"/> Allow Friend Requests</div><div class=\"settingRadio\"><input id=\"prefClanInvites\" type=\"checkbox\"/> Allow Clan Invitations</div><div class=\"settingRadio\" title=\"Reply from the game's chat with /w name message, or /r message\"><input id=\"prefToastWhispers\" type=\"checkbox\"/> Show Friend Messages In Game</div><div class=\"settingRadio\" title=\"Reply from the game's chat with /c message\"><input id=\"prefToastClan\" type=\"checkbox\"/> Show Clan Messages In Game</div><div class=\"settingRadio\" title=\"Other players see Anon#number for your name, and no clan. You still see you